<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".ui.siteSelectionView.SiteSelectionViewActivity"
    tools:ignore="MissingDefaultResource"
    tools:showIn="@layout/activity_site_selection_view">


    <include layout="@layout/action_bar" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/loutSiteSelectionView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_25sdp"
            android:orientation="vertical"
            android:visibility="visible">

            <com.brinfotech.feedbacksystem.customClasses.FontTextViewBold
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/please_select_site"
                android:textColor="@color/whiteColor"
                android:textSize="@dimen/headerTextSize" />

            <EditText
                android:id="@+id/edtSiteName"
                android:layout_width="@dimen/_250sdp"
                android:layout_height="@dimen/_45sdp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/common_margin"
                android:background="@drawable/edt_background"
                android:editable="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:hint="@string/select_site_here"
                android:maxLines="1"
                android:paddingStart="@dimen/common_margin"
                android:paddingLeft="@dimen/common_margin"
                android:textColor="@color/grayColor"
                android:textSize="@dimen/mediumTextSize" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="@dimen/_250sdp"
                android:layout_height="@dimen/_45sdp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/common_margin"
                android:background="@drawable/btn_theme_border_color"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/whiteColor"
                android:textSize="@dimen/mediumTextSize" />

            <ImageView
                android:id="@+id/imgBackToMainMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/common_margin"
                android:src="@drawable/ic_back_to_main_menu"
                android:visibility="gone" />

        </LinearLayout>


    </LinearLayout>


    <com.brinfotech.feedbacksystem.customClasses.FontsTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_margin"
        android:gravity="center_vertical|center"
        android:text="@string/login_bottom_title"
        android:textColor="#929292"
        android:textSize="@dimen/smallTextSize"
        android:visibility="gone" />


</LinearLayout>